{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "nixpacks",
    "nixpacks": {
      "aptPackages": [],
      "buildCommand": "echo 'static site'",
      "startCommand": "node server.js"
    }
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "on_failure",
    "restartPolicyMaxRetries": 5
  }
}
